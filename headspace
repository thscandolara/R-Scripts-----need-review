# --- 7.3 Função auxiliar: evita repetição de código ---
run_enrichment <- function(entrez_ids, label, results_dir,
                           pval = PARAM_pval_enrich,
                           qval = PARAM_qval_enrich) {
  ego <- enrichGO(
    gene = entrez_ids, OrgDb = org.Hs.eg.db,
    keyType = "ENTREZID", ont = "BP",
    pAdjustMethod = "BH",
    pvalueCutoff = pval, qvalueCutoff = qval,
    readable = TRUE
  )
  ekegg <- enrichKEGG(
    gene = entrez_ids, organism = "hsa",
    pAdjustMethod = "BH",
    pvalueCutoff = pval, qvalueCutoff = qval
  )
  ereact <- enrichPathway(
    gene = entrez_ids, organism = "human",
    pAdjustMethod = "BH",
    pvalueCutoff = pval, qvalueCutoff = qval,
    readable = TRUE
  )
  ereact <- pairwise_termsim(ereact)

  write.csv(as.data.frame(ego),    file.path(results_dir, paste0("GO_BP_",   label, ".csv")))
  write.csv(as.data.frame(ekegg),  file.path(results_dir, paste0("KEGG_",    label, ".csv")))
  write.csv(as.data.frame(ereact), file.path(results_dir, paste0("Reactome_",label, ".csv")))

  print(barplot(ego,    showCategory = 20, title = paste("GO BP —",  label)))
  print(dotplot(ekegg,  showCategory = 20, title = paste("KEGG —",   label)))
  print(emapplot(ereact, showCategory = 20))

  list(GO = ego, KEGG = ekegg, Reactome = ereact)
}

