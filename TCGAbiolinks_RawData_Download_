#Mover arquivos idat para uma pasta só

# Listar todos os subdiretórios dentro de 'Masked_Intensities'
subdirectories <- list.dirs(full.names = FALSE, recursive = FALSE)
#260 pastas

getwd()
# Loop through each subdirectory
for (subdir in subdirectories) {
  # List all files in the subdirectory with the .idat extension
  idat_files <- list.files(path = subdir, pattern = "\\.idat$", full.names = TRUE)
  
  # Move the .idat files to the parent directory ('Masked_Intensities')
  file.copy(from = idat_files, to = file.path("/data04/projects04/SheilaCoelho/headspace_methyl/data/idats_tcga_larynx_tumors"))
  
  # Optionally, you can uncomment the line below to delete the original files after copying
  # file.remove(idat_files)
}


#Sample sheet que baixei do site do GDC (dei upload no R)
sample_sheet <- read.table("gdc_sample_sheet.2024-02-01.tsv",
                           sep = "\t",
                           header = T)

#Transformar em formato pd file
pd <- sample_sheet[,c("File.Name","Project.ID","Sample.ID","Sample.Type")]
pd$Sentrix_ID <- substr(pd$File.Name,1,36) 
pd$Sentrix_Position <- substr(pd$File.Name,38,41) 
pd$Sample_Group <- ifelse(pd$Sample.Type == "Solid Tissue Normal","normal","tumor")
pd <- pd[,c(3,7,2,5,6)]
names(pd)[c(1,3)] <- c("Sample_Name","Project")
pd1 <- pd[duplicated(pd$Sentrix_ID),]
write.csv(pd1,file = "/data04/projects04/SheilaCoelho/headspace_methyl/data/idats_tcga_larynx_tumors/sample_sheet.csv",quote = F,row.names = F)

